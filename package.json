{
  "name": "telegram-task-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "prepare:dev": "sh scripts/prepare-dev.sh",
    "setup:vps": "sh scripts/vps-auto-setup.sh",
    "telegram:webhook": "sh scripts/setup-telegram-webhook.sh",
    "telegram:import-export": "node scripts/import-telegram-desktop-export.js",
    "telegram:import-export:docker": "sh scripts/import-telegram-export-docker.sh",
    "telegram:process-pending:docker": "sh scripts/process-pending-docker.sh",
    "runtime:telegram-check": "sh scripts/check-telegram-runtime.sh",
    "runtime:openrouter-check": "sh scripts/check-openrouter-runtime.sh",
    "runtime:validate": "sh scripts/validate-runtime-env.sh",
    "runtime:validate:strict": "sh scripts/validate-runtime-env.sh --strict",
    "runtime:checklist": "sh scripts/runtime-checklist.sh",
    "runtime:verify-state": "sh scripts/verify-runtime-state.sh",
    "runtime:replay-webhook": "sh scripts/replay-telegram-fixtures.sh",
    "runtime:smoke-api": "sh scripts/smoke-api.sh",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,md,json,yml,yaml}\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "dashboard:dev": "pnpm --dir dashboard dev",
    "dashboard:build": "pnpm --dir dashboard build",
    "dashboard:deploy": "sh scripts/deploy-dashboard.sh",
    "dashboard:preview": "pnpm --dir dashboard preview",
    "db:backup": "sh scripts/backup-db.sh",
    "db:restore": "sh scripts/restore-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "drizzle-orm": "^0.44.0",
    "grammy": "^1.30.0",
    "nestjs-pino": "^4.3.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.3.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
